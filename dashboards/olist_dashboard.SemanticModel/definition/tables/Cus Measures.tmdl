table 'Cus Measures'
	lineageTag: 4b1721a5-8349-4cc6-bf30-6128b6527df6

	measure 'Revenue per Customer' =
			
			DIVIDE(
			    [Total Revenue],
			    [Unique Customers]
			)
		lineageTag: dfafa740-4c1d-46d7-96ee-3f5ee0d38a0a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Orders per Customer' =
			
			DIVIDE(
			    [Total Orders],
			    [Unique Customers]
			)
		lineageTag: 716c4fcb-ef03-46d8-bc41-9b0fa22323e4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customer Count' =
			
			DISTINCTCOUNT('public fact_orders'[customer_sk])
		formatString: 0
		lineageTag: 5df394f2-dfc7-4041-a88b-19d90f15ad69

	partition 'Cus Measures' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
